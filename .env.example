# Vyaparo Environment Configuration Example
# Copy this file to .env and provide your values

# App & Server
PORT=3000
NODE_ENV=development
PUBLIC_SITE_URL=https://vyaparo.com

# Google Gemini AI Assistant (Used server-side in /api/ai/chat)
GEMINI_API_KEY=

# Supabase (PostgreSQL Database & Auth)
# When configured, Vyaparo seamlessly syncs with Supabase PostgreSQL tables & RLS.
# When omitted, Vyaparo runs with the high-performance local persistent database engine.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payment Gateway (Razorpay or Indian Payment Gateway Sandbox/Live)
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
